---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtYear = (d: Date) => d.getFullYear().toString();
---
<Base>
  <h1>Varun Lohade</h1>
  <p class="sub">Engineer &middot; AI, Crypto, Robotics</p>

  <p>
    I build things. Mostly software, sometimes hardware.
    Currently thinking about agents, on-chain finance, and machines that move.
  </p>

  <h2>Work</h2>
  <ul>
    <li>
      <span class="tag">crypto</span>
      <span class="row-text"><a href="https://avici.money">Avici.money</a> <span class="desc">— cofounder, technical founder. On-chain finance.</span></span>
    </li>
    <li>
      <span class="tag">ai</span>
      <span class="row-text"><a href="https://github.com/varunlohade/fixmahbug">fixmahbug</a> <span class="desc">— anyone on the team can fix small bugs without pulling an engineer; prompts route into the engineer's project-aware Claude.</span></span>
    </li>
    <li>
      <span class="tag">robotics</span>
      <span class="row-text">robotic arm <span class="desc">— LLM-driven. Ongoing.</span></span>
    </li>
  </ul>

  <h2>Writing</h2>
  <ul>
    {posts.map((p) => (
      <li>
        <span class="tag">{fmtYear(p.data.date)}</span>
        <span class="row-text"><a href={`/writing/${p.slug}/`}>{p.data.title}</a>{p.data.description && <span class="desc"> — {p.data.description}</span>}</span>
      </li>
    ))}
    <li>
      <span class="tag">medium</span>
      <span class="row-text"><a href="https://medium.com/@varunlohade">@varunlohade</a> <span class="desc">— older essays.</span></span>
    </li>
  </ul>

  <h2>Now</h2>
  <ul>
    <li>
      <span class="tag">thinking</span>
      <span class="row-text">parallel agents interacting with each other to process interactions faster.</span>
    </li>
    <li>
      <span class="tag">learning</span>
      <span class="row-text"><em>Modern Robotics</em> — Kevin Lynch, Northwestern.</span>
    </li>
    <li>
      <span class="tag">building</span>
      <span class="row-text">Avici.money, fixmahbug, the arm.</span>
    </li>
  </ul>

  <h2>Elsewhere</h2>
  <ul class="contact-row">
    <li><a href="mailto:varunlohade@gmail.com">email</a></li>
    <li><a href="https://github.com/varunlohade">github</a></li>
  </ul>

  <footer>
    last updated 2026-05-14
  </footer>
</Base>
