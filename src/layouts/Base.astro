---
interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}
const {
  title = 'Varun Lohade',
  description = 'Varun Lohade — software engineer. Mobile apps, AI tools, and things that move.',
  bodyClass,
} = Astro.props;
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
