---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { identity, work, now, contact, about } from '../data/site';

const entries = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const posts = entries.map((p) => ({
  slug: p.slug,
  title: p.data.title,
  date: p.data.date.toISOString().slice(0, 10),
  description: p.data.description ?? '',
  body: p.body,
}));

// Strips the inline markup so the no-JS fallback stays readable.
const plain = (s: string) =>
  s
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '$1')
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/`([^`]+)`/g, '$1');
---

<Base>
  <main class="term">
    <div class="term__scroll">
      <div class="term__out"></div>
    </div>

    <div class="composer">
      <div class="menu" hidden role="listbox" aria-label="Commands"></div>
      <div class="queued" aria-live="polite"></div>

      <div class="input">
        <span class="input__caret">&gt;</span>
        <div class="input__field">
          <div class="input__mirror" aria-hidden="true"></div>
          <input
            class="input__real"
            type="text"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            aria-label="Ask about Varun"
          />
        </div>
      </div>

      <div class="status">
        <span>? for shortcuts</span>
        <span class="status__right">varun-1.0 · {identity.cwd}</span>
      </div>
    </div>
  </main>

  <script type="application/json" id="site-posts" set:html={JSON.stringify(posts)} />

  <noscript>
    <div class="page">
      <h1>{identity.name}</h1>
      <p class="meta">{identity.tagline}</p>
      {about.map((p) => <p>{plain(p)}</p>)}

      <h2>Work</h2>
      <ul>{work.map((r) => <li>{r.tag} — {plain(r.text)}</li>)}</ul>

      <h2>Writing</h2>
      <ul>
        {posts.map((p) => (
          <li>
            <a href={`/writing/${p.slug}/`}>{p.title}</a> — {p.date}
          </li>
        ))}
        <li><a href="https://medium.com/@varunlohade">Medium</a> — older essays.</li>
      </ul>

      <h2>Now</h2>
      <ul>{now.map((r) => <li>{r.tag} — {plain(r.text)}</li>)}</ul>

      <h2>Elsewhere</h2>
      <ul>{contact.map((r) => <li>{r.tag} — {plain(r.text)}</li>)}</ul>

      <footer>last updated {identity.updated}</footer>
    </div>
  </noscript>

  <script>
    import '../scripts/terminal.ts';
  </script>
</Base>
