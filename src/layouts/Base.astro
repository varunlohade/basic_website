---
interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}
const {
  title = 'Varun Lohade',
  description = 'Varun Lohade — engineer. AI, crypto, robotics. Cofounder at Avici.money.',
  bodyClass,
} = Astro.props;
import '../styles/terminal.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#16150f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%2316150f'/%3E%3Ctext x='16' y='23' font-size='20' text-anchor='middle' fill='%23d97757' font-family='monospace'%3E%E2%9C%BB%3C/text%3E%3C/svg%3E"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
