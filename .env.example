# Powers /api/ask — the terminal's free-form answers.
# Without these the site still works: unmatched questions fall back to the
# built-in keyword answers in src/data/site.ts.
#
# CF_ACCOUNT_ID: Cloudflare dashboard → Workers & Pages → Account ID
# CF_API_TOKEN:  My Profile → API Tokens → Create Token → Workers AI (read)
#
# Local: copy to `.env`. Production: set both in your host's env settings.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# --- optional: point at a different provider ---------------------------------
# /api/ask speaks the OpenAI-compatible chat-completions shape, so any of these
# work by setting the two vars below instead of CF_ACCOUNT_ID:
#   Groq       AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
#   OpenRouter AI_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
#   Ollama     AI_ENDPOINT=http://localhost:11434/v1/chat/completions
# AI_ENDPOINT=
# AI_MODEL=

# The guard call defaults to the same model as the answering call. Set this to
# use a smaller/cheaper one for classification.
# AI_GUARD_MODEL=
